{% extends 'base.html.twig' %}

{% block title %}Logistique : Villes{% endblock %}

{% block body %}
<div class="container py-5">
    {# En-tête de section style Alpha #}
    <div class="d-flex align-items-center gap-3 mb-5 border-bottom border-alpha pb-3">
        <strong class="alpha-symbol fs-1">α</strong>
        <h1 class="display-6 fw-black text-uppercase italic mb-0">Gestion des Villes</h1>
    </div>

    <div class="table-responsive bg-dark-alpha border border-alpha p-3">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead class="text-primary-alpha text-uppercase small ls-1">
                <tr>
                    <th>ID</th>
                    <th>Nom de la ville</th>
                    <th class="text-center">Frais de port</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="text-white">
            {% for city in cities %}
                <tr class="border-bottom border-secondary">
                    <td class="py-3 text-secondary-alpha italic">#{{ city.id }}</td>
                    <td class="fw-bold text-uppercase">{{ city.name }}</td>
                    <td class="text-center">{{ city.shippingCost|number_format(2, ',', ' ') }} €</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-3">
                            <a href="{{ path('app_city_show', {'id': city.id}) }}" class="text-white-50 hover-gold">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('app_city_edit', {'id': city.id}) }}" class="text-primary-alpha hover-gold">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            {{ include('city/_delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-5 text-secondary-alpha italic">
                        <i class="bi bi-exclamation-circle me-2"></i>Aucune zone logistique répertoriée.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-4 d-flex justify-content-between align-items-center">
        <a href="{{ path('app_home_page') }}" class="text-secondary-alpha text-decoration-none hover-gold small">
            <i class="bi bi-arrow-left me-1"></i> RETOUR AU SYSTÈME
        </a>
        
        <a href="{{ path('app_city_new') }}" class="btn btn-alpha-action px-4 py-2 fw-black text-uppercase transform-hover">
            <i class="bi bi-plus-lg me-2"></i>Forger une ville
        </a>
    </div>
</div>
{% endblock %}