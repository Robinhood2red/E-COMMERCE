{% extends 'base.html.twig' %}

{% block title %}Forger une Unité | Alpha Control{% endblock %}

{% block body %}
<div class="container py-5">
    {# En-tête de déploiement #}
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary pb-4">
        <div>
            <h1 class="display-4 fw-black tracking-tighter text-uppercase italic">
                <span class="text-primary-alpha">FORGER</span> un produit / Service
            </h1>
            <p class="text-secondary-alpha mb-0 text-uppercase small ls-2">Enregistrement d'un nouveau produit dans la base de données.</p>
        </div>
        <a href="{{ path('app_product_index') }}" class="btn btn-outline-light px-4 py-2 rounded-0 text-uppercase fw-bold ls-1">
            <i class="bi bi-arrow-left"></i> Retour Inventaire
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark-alpha border-alpha rounded-0 shadow-lg">
                <div class="card-header border-bottom border-alpha p-4">
                    <h2 class="h5 mb-0 text-white text-uppercase fw-black tracking-widest">
                        <i class="bi bi-cpu-fill text-primary-alpha me-2"></i> Spécifications du produit
                    </h2>
                </div>
                
                <div class="card-body p-5">
                    {# Inclusion du formulaire stylisé #}
                    {{ include('product/_form.html.twig', {'button_label': 'Crée le produit'}) }}
                </div>
                
                {# Élément décoratif type barre de chargement #}
                <div class="alpha-loader"></div>
            </div>
            
            <div class="mt-4 text-center">
                <p class="small text-secondary-alpha text-uppercase ls-1">
                    <i class="bi bi-info-circle me-1"></i> Assurez-vous que toutes les métadonnées sont conformes au protocole.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}