{# templates/_footer.html.twig #}
<footer class="mt-5 border-top border-alpha bg-dark-alpha pt-5 pb-4">
    <div class="container">
        <div class="row g-4">
            {# Section Identité - Style Commando #}
            <div class="col-lg-4 col-md-12 mb-4 mb-md-0">
                <a class="navbar-brand brand-alpha d-flex align-items-center mb-3" href="{{ path('app_home_page') }}">
                    <span class="alpha-symbol">α</span>
                    <span class="ms-1 text-white tracking-tighter">lpha</span>
                    <span class="shop-text fw-black text-primary-alpha ms-1">COMMANDO</span>
                </a>
                <p class="text-secondary-alpha small text-uppercase ls-1 leading-relaxed">
                    Infrastructure de déploiement tactique pour l'élite digitale. 
                    Gérez vos ressources avec une précision chirurgicale. [cite: 70]
                </p>
                <div class="d-flex gap-3 mt-4">
                    <a href="#" class="alpha-icon-box text-decoration-none transform-hover">
                        <i class="bi bi-discord"></i>
                    </a>
                    <a href="#" class="alpha-icon-box text-decoration-none transform-hover">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="#" class="alpha-icon-box text-decoration-none transform-hover">
                        <i class="bi bi-terminal-fill"></i>
                    </a>
                </div>
            </div>

            {# Section Navigation - Liens vers tes contrôleurs #}
            <div class="col-lg-2 col-md-4 mb-4">
                <h5 class="text-white fw-black text-uppercase tracking-widest small mb-4">Protocole</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a href="{{ path('app_home_page') }}" class="text-secondary-alpha text-decoration-none small text-uppercase ls-1 hover-gold">
                            <i class="bi bi-chevron-right small me-1"></i> Accueil
                        </a>
                    </li>
                    <li class="mb-2">
                        <a href="{{ path('app_category') }}" class="text-secondary-alpha text-decoration-none small text-uppercase ls-1 hover-gold">
                            <i class="bi bi-chevron-right small me-1"></i> Catégories
                        </a>
                    </li>
                </ul>
            </div>

            {# Section Administration #}
            <div class="col-lg-3 col-md-4 mb-4">
                <h5 class="text-white fw-black text-uppercase tracking-widest small mb-4">Logistique</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a href="{{ path('app_alpha_camp_index') }}" class="text-secondary-alpha text-decoration-none small text-uppercase ls-1 hover-gold">
                            Camp d'entraînement
                        </a>
                    </li>
                    <li class="mb-2">
                        <a href="#" class="text-secondary-alpha text-decoration-none small text-uppercase ls-1 hover-gold">
                            Rapports de mission
                        </a>
                    </li>
                </ul>
            </div>

            {# Section Status Système - Utilise tes animations CSS #}
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="p-3 border border-alpha bg-black bg-opacity-25 shadow-sm">
                    <h5 class="text-primary-alpha fw-black text-uppercase tracking-widest small mb-3">Status Système</h5>
                    <div class="d-flex align-items-center small mb-2 text-white">
                        <span class="p-1 bg-success rounded-circle me-2 animate-pulse"></span>
                        <span class="text-uppercase ls-1" style="font-size: 0.7rem;">Matrice Opérationnelle</span>
                    </div>
                    <div class="d-flex align-items-center small text-secondary-alpha">
                        <i class="bi bi-cpu me-2"></i>
                        <span class="text-uppercase ls-1" style="font-size: 0.7rem;">Node: Alpha-{{ "now"|date("d-m") }}</span>
                    </div>
                </div>
            </div>
        </div>

        <hr class="border-alpha my-4 opacity-25">

        {# Copyright et Barre de chargement #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <span class="text-secondary-alpha mb-0 text-uppercase small ls-2" style="font-size: 0.65rem;">
                &copy; {{ "now"|date("Y") }} ALPHA COMMAND. TOUS DROITS RÉSERVÉS AU BUNKER. 
            </span>
            <div class="alpha-loader" style="width: 150px; height: 1px; position: relative; opacity: 0.5;"></div>
        </div>
    </div>
</footer>