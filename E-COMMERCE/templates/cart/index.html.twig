{# templates/cart/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Pannier{% endblock %}

{% block body %}
<div class="container py-5">
{% include 'layouts/_flash_message.html.twig' %}
    {# En-tête de section #}
    <div class="d-flex align-items-center gap-3 mb-5 border-bottom border-alpha pb-3">
        <strong class="alpha-symbol fs-1">α</strong>
        <h1 class="display-6 fw-black text-uppercase italic mb-0">Votre panier</h1>
    </div>

    {% if items is empty %}
        {# État vide avec style terminal #}
        <div class="text-center py-5 border border-alpha bg-dark-alpha">
            <i class="bi bi-exclamation-triangle text-primary-alpha display-1 mb-3"></i>
            <h3 class="text-white text-uppercase ls-2">Aucune produit détectée</h3>
            <p class="text-secondary-alpha italic">Votre panier est actuellement vide.</p>
            <a href="{{ path('app_home_page') }}" class="btn btn-alpha-action mt-3 transform-hover">
                RETOUR à l'accueil
            </a>
        </div>
    {% else %}
        <div class="row g-4">
            {# Liste des items #}
            <div class="col-lg-8">
                <div class="table-responsive bg-dark-alpha border border-alpha p-3">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="text-primary-alpha text-uppercase small ls-1">
                            <tr>
                                <th>Désignation</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-end">Crédits Unitaire</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Action</th> {# Nouvelle colonne pour la suppression #}
                            </tr>
                        </thead>
                        <tbody class="text-white">
                            {% for item in items %}
                                <tr class="border-bottom border-secondary">
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="{{ asset('/images/' ~ item.produit.images) }}" 
                                                alt="{{ item.produit.name }}" 
                                                style="width: 50px; height: 50px; object-fit: cover;"
                                                class="border border-alpha">
                                            <div>
                                                <span class="fw-bold d-block">{{ item.produit.name|upper }}</span>
                                                <span class="text-secondary-alpha x-small italic" style="font-size: 0.7rem;">
                                                    ID: #{{ item.produit.id }}
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    {# Gestion des quantités avec boutons plus/moins #}
                                    <td class="text-center fw-black">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <a href="{{ path('app_cart_remove', {'id': item.produit.id}) }}" class="btn btn-sm btn-outline-alpha-white p-1" style="line-height: 1;">
                                                <i class="bi bi-dash"></i>
                                            </a>
                                            
                                            <span class="mx-1">{{ item.quantite }}</span>
                                            
                                            <a href="{{ path('app_cart_add', {'id': item.produit.id}) }}" class="btn btn-sm btn-outline-alpha-white p-1" style="line-height: 1;">
                                                <i class="bi bi-plus"></i>
                                            </a>
                                        </div>
                                    </td>

                                    <td class="text-end">{{ item.produit.price }} €</td>
                                    <td class="text-end text-primary-alpha fw-bold">
                                        {{ item.produit.price * item.quantite }} €
                                    </td>

                                    {# Bouton de suppression totale de la ligne #}
                                    <td class="text-center">
                                        <a href="{{ path('app_cart_delete', {'id': item.produit.id}) }}" class="text-danger hover-gold opacity-75">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-4">
                    <a href="{{ path('app_home_page') }}" class="text-secondary-alpha text-decoration-none hover-gold small">
                        <i class="bi bi-plus-circle me-1"></i> AJOUTER D'AUTRES UNITÉS
                    </a>
                </div>
            </div>

            {# Résumé de la commande (Sidebar) #}
            <div class="col-lg-4">
                <div class="card bg-dark-alpha border-alpha rounded-0 p-4 sticky-top" style="top: 20px;">
                    <h4 class="text-white fw-black text-uppercase ls-2 mb-4">Rapport Logistique</h4>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary-alpha">Unités engagées :</span>
                        <span class="text-white fw-bold">{{ items|length }}</span>
                    </div>
                    
                    <hr class="border-alpha opacity-25">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-white text-uppercase fw-black">Total de l'opération</span>
                        <span class="h3 text-primary-alpha fw-black mb-0">{{ total }} €</span>
                    </div>

                    <div class="d-grid gap-3">
                        <button class="btn btn-alpha-action py-3 fw-black text-uppercase transform-hover">
                            Valider l'achat <i class="bi bi-shield-lock-fill ms-2"></i>
                        </button>
                        
                        {# Badge de sécurité système #}
                        <div class="p-2 border border-alpha bg-black bg-opacity-25 text-center mt-2">
                            <span class="text-success small animate-pulse">
                                <i class="bi bi-shield-check me-2"></i>CANAL ALPHA SÉCURISÉ
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}