{% extends 'base.html.twig' %}

{% block title %}Hello CategoryController!{% endblock %}

{% block body %}
    <table class="table">
        <tr>
            <th>Nom de la categorie</th>
            <th>Action</th>
        </tr>
        {% for category in categories %}
            <tr>
                <td>
                    {{ category.name }}
                </td>
                <td>
                    <a href="{{ path('app_category_update', {'id':category.id}) }}" class="btn btn-outline-primary">Modifier</a>
                    <a href="{{ path('app_category_delete', {'id':category.id}) }}" class="btn btn-danger">Supprimer</a>
                </td>
            </tr>
        {% else %}
        <p>Aucune catégorie à afficher</p>
    </table>
    {# <a href="{{ path('app_category_new', ) }}" class="btn btn-success">Ajoutez une catégorie</a> #}
{% endfor %}
{% endblock %}
