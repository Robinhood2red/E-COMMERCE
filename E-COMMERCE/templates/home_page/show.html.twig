{# templates/home_page/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Alpha Command{% endblock %}

{% block body %}
<div class="container py-5">
    {# Bouton retour avec animation Alpha #}
    <div class="mb-4">
        <a href="{{ path('app_home_page') }}" class="btn btn-outline-light alpha-link py-2 px-3 transform-hover">
            <i class="bi bi-arrow-left"></i> RETOUR AU CENTRE DE DÉPLOIEMENT
        </a>
    </div>

    <div class="row g-5">
        {# Colonne Image avec effet Zoom et Container Alpha #}
        <div class="col-md-6">
            <div class="product-image-container bg-dark-custom shadow-lg overflow-hidden border-alpha">
                <img src="{{ asset('/images/' ~ product.images) }}" 
                    class="img-fluid w-100 zoom-img" 
                    alt="{{ product.name }}"
                    style="max-height: 500px; object-fit: contain;">
                <div class="alpha-loader"></div> {# Barre d'animation de chargement #}
            </div>
        </div>

        {# Colonne Infos #}
        <div class="col-md-6">
            <div class="ps-lg-4">
                    
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        {# Badge fixe Alpha #}
                        <span class="badge bg-success-soft text-primary-alpha px-3 py-2 rounded-0 border-alpha">
                            CERTIFIÉ ALPHA α
                        </span>
                        
                        {# AFFICHAGE DE LA CATÉGORIE PRINCIPALE (DORÉ) #}
                        {% if product.categorie is not null %}
                            <span class="badge bg-dark border-alpha text-primary-alpha px-3 py-2 rounded-0">
                                <i class="bi bi-tag-fill me-1"></i> {{ product.categorie.name|upper }}
                            </span>
                        {% endif %}

                        {# AFFICHAGE DES SOUS-CATÉGORIES (GRIS) #}
                        {% for sub in product.subCategory %}
                            <span class="badge bg-dark border-alpha text-secondary-alpha px-3 py-2 rounded-0">
                                <i class="bi bi-layers-half me-1"></i> {{ sub.name }}
                            </span>
                        {% endfor %}
                    </div>
                
                <h1 class="display-5 fw-black text-uppercase italic mb-3">{{ product.name }}</h1>
                
                {# Prix Doré #}
                <div class="h3 fw-black text-primary-alpha mb-4">
                    {{ product.price|default('0') }} €
                </div>

                <hr class="border-secondary opacity-25 my-4">

                {# Description Tactique #}
                <h5 class="fw-black text-uppercase ls-2 text-secondary-alpha mb-3">Spécifications de l'unité</h5>
                <p class="leading-relaxed text-white italic" style="text-align: justify; white-space: pre-line;">
                    {{ product.productDescription }}
                </p>

                {# Actions avec boutons Alpha #}
                <div class="d-grid gap-3 d-md-flex mt-5">
                    <button class="btn btn-alpha-action btn-lg px-5 py-3 flex-grow-1 transform-hover">
                        <i class="bi bi-cart-plus me-2"></i> AJOUTER À L'INVENTAIRE
                    </button>
                    <button class="btn btn-outline-danger btn-lg px-4 py-3 rounded-0 border-alpha transform-hover">
                        <i class="bi bi-heart-fill"></i>
                    </button>
                </div>
                
                {# État du Stock #}
                <div class="mt-4 pt-3 border-top border-alpha">
                    <p class="small text-secondary-alpha mb-0">
                        <i class="bi bi-shield-check me-2"></i> 
                        DISPONIBILITÉ : 
                        <span class="{{ product.stock > 0 ? 'text-success animate-pulse' : 'text-danger' }} fw-bold">
                            {{ product.stock > 0 ? 'UNITÉS PRÊTES (' ~ product.stock ~ ')' : 'RÉAPPROVISIONNEMENT' }}
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# --------- SUGGESTIONS AVEC ANIMATIONS CARD -------------- #}
    <div class="mt-5 pt-5 border-top border-alpha">
        <h2 class="fw-black text-uppercase ls-3 mb-4 text-primary-alpha">Unités de soutien disponibles</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            {% for item in products %}
                {% if item.id != product.id %}
                    <div class="col">
                        <div class="card h-100 bg-dark-alpha border-alpha rounded-0 custom-card transform-alpha-hover overflow-hidden">
                            <div class="img-container">
                                <img src="{{ asset('/images/' ~ item.images) }}" 
                                    class="card-img-top rounded-0" 
                                    alt="{{ item.name }}">
                                <div class="alpha-loader"></div>
                            </div>
                            <div class="card-body d-flex flex-column text-center">
                                <h5 class="card-title fw-black text-uppercase">{{ item.name }}</h5>
                                <p class="card-text text-secondary-alpha small italic">
                                    {{ item.productDescription|slice(0, 45) }}...
                                </p>
                                <div class="mt-auto">
                                    <span class="fw-black text-primary-alpha d-block mb-3">{{ item.price }} €</span>
                                    <div class="d-grid">
                                        <a href="{{ path('app_home_product_show', {'id': item.id}) }}" 
                                           class="btn btn-sm btn-alpha-action py-2">
                                            DÉTAILS
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}