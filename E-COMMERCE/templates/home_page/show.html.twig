{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="container py-5">
    {# Bouton retour #}
    <div class="mb-4">
        <a href="{{ path('app_home_page') }}" class="btn btn-link text-decoration-none text-muted p-0">
            <i class="bi bi-arrow-left"></i> Retour aux produits
        </a>
    </div>

    <div class="row g-5">
        {# Colonne Image #}
        <div class="col-md-6">
            <div class="product-image-container bg-dark-custom shadow-sm rounded-4 overflow-hidden">
                <img src="{{ asset('/images/' ~ product.images) }}" 
                    class="img-fluid w-100 zoom-img" 
                    alt="{{ product.name }}"
                    style="max-height: 500px; object-fit: contain;">
            </div>
        </div>

        {# Colonne Infos #}
        <div class="col-md-6">
            <div class="ps-lg-4">
                <nav aria-label="breadcrumb" class="mb-2">
                    <span class="badge bg-success-soft text-success mb-2">Certifié Alpha α</span>
                </nav>
                
                <h1 class="display-5 fw-bold mb-3">{{ product.name }}</h1>
                
                {# Prix #}
                <div class="h3 fw-light text-success mb-4">
                    {{ product.price|default('Prix sur demande') }} €
                </div>

                <hr class="my-4 text-muted opacity-25">

                {# Description #}
                <h5 class="fw-bold">Description</h5>
                <p class="leading-relaxed" style="text-align: justify; white-space: pre-line;">
                    {{ product.productDescription }}
                </p>

                {# Btn ajouter au panier et Coup de coeur #}
                <div class="d-grid gap-2 d-md-flex mt-5">
                    <button class="btn btn-success btn-lg px-5 py-3 shadow-sm rounded-pill">
                        Ajouter au panier
                    </button>
                    <button class="btn btn-outline-danger btn-lg px-4 py-3 rounded-pill">
                        <i class="bi bi-heart-fill"></i>
                    </button>
                </div>
                
                {# Texte livraison #}
                <div class="mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">
                        <i class="bi text-light bi-truck"> Livraison gratuite sous 3 à 5 jours ouvrés.</i>
                    </p>
                </div>
            </div>
        </div>
    </div>
    {#* --------- NOUVEAUTÉS -------------- #}
        <div class="mt-5 pt-5">
            <h2 class="fw-bold mb-4">Derniers produits ajoutés</h2>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                {% for item in products %}
                    {% if item.id != product.id %}
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                <img src="{{ asset('/images/' ~ item.images) }}" 
                                    class="card-img-top" 
                                    alt="{{ item.name }}"
                                    style="height: 200px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fw-bold">{{ item.name }}</h5>
                                    <p class="card-text text-muted small">
                                        {{ item.productDescription|slice(0, 60) }}...
                                    </p>
                                    
                                    <div class="mt-auto">
                                        <span class="fw-bold text-success d-block mb-3">{{ item.price }} €</span>
                                        
                                        <div class="d-grid gap-2">
                                            {# Bouton Ajouter au panier (Principal) #}
                                            <button class="btn btn-sm btn-success rounded-pill">
                                                <i class="bi bi-cart-plus"></i> Ajouter
                                            </button>
                                            {# Bouton Voir (Secondaire) #}
                                            <a href="{{ path('app_home_product_show', {'id': item.id}) }}" 
                                            class="btn btn-sm btn-outline-secondary border-0 small">
                                                Détails
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="mt-4 text-sm-start">
                <p class="text-light small fst-italic">Dernière mise à jour il y a 3 minutes</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}