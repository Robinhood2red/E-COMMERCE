{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-5 text-center fw-bold">Nos Produits</h1>
    <div class="row g-4">
        {% for product in products %}
            <div class="col-12 col-sm-6 col-lg-3">
                {# On entoure la card avec le lien, ou on utilise la classe 'stretched-link' de Bootstrap #}
                <div class="card h-100 custom-card border-0 shadow-sm position-relative">
                    <div class="img-container">
                        {#* ~ vaut . ou + // Si product.images vaut guitare.jpg, Twig transformera cela en /images/guitare.jpg. #}
                        <img src="{{ asset('/images/' ~ product.images) }}" class="card-img-top img-fluid" alt="{{ product.name }}">
                        <div class="card-overlay">
                            <span class="badge bg-light text-dark shadow-sm">Certifié Alpha α</span>
                        </div>
                    </div>
                    
                    <div class="card-body d-flex flex-column text-center">
                        {# Le lien invisible qui rend toute la carte cliquable sans casser le design #}
                        <a href="{{ path('app_home_product_show', {'id': product.id}) }}" class="stretched-link text-decoration-none text-dark">
                            <h2 class="card-title h5 fw-bold mb-3">{{ product.name }}</h2>
                        </a>

                        <p class="card-text small mb-4 text-muted" style="text-align: justify;">
                            {{ product.productDescription|slice(0, 100) }}...
                        </p>
                        
                        {# On ajoute 'z-index: 2' pour que le bouton reste cliquable par-dessus le lien global #}
                        <div class="mt-auto" style="position: relative; z-index: 2;">
                            <a href="#" class="btn btn-outline-success w-100 shadow-sm">Ajouter au panier</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% endblock %}