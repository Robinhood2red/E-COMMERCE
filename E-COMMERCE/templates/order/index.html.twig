{% extends 'base.html.twig' %}

{% block title %}Alpha System : Finalisation Commande{% endblock %}

{% block body %}
<div class="container py-5">
    {# En-tête de progression #}
    <div class="d-flex align-items-center gap-3 mb-5 border-bottom border-alpha pb-3">
        <strong class="alpha-symbol fs-1">α</strong>
        <div>
            <h1 class="display-6 fw-black text-uppercase italic mb-0">Tunnel de Commande</h1>
            <small class="text-primary-alpha ls-2 uppercase">Initialisation du protocole d'acquisition</small>
        </div>
    </div>

    <div class="row g-4">
        {# Colonne de gauche : Formulaire de livraison #}
        <div class="col-lg-8">
            <div class="card bg-dark-alpha border-alpha rounded-0 p-4 shadow-lg h-100">
                <h4 class="text-white fw-black text-uppercase ls-1 mb-4">
                    <i class="bi bi-truck text-primary-alpha me-2"></i>Coordonnées de Livraison
                </h4>
                
                {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-secondary-alpha small text-uppercase ls-1">Prénom</label>
                            {{ form_widget(form.firstName, {'attr': {'class': 'form-control bg-transparent border-alpha text-white rounded-0'}}) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-secondary-alpha small text-uppercase ls-1">Nom</label>
                            {{ form_widget(form.lastName, {'attr': {'class': 'form-control bg-transparent border-alpha text-white rounded-0'}}) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary-alpha small text-uppercase ls-1">Téléphone</label>
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control bg-transparent border-alpha text-white rounded-0'}}) }}
                    </div>

                    <div class="mb-3">
                        <label class="text-secondary-alpha small text-uppercase ls-1">Adresse complète</label>
                        {{ form_widget(form.address, {'attr': {'class': 'form-control bg-transparent border-alpha text-white rounded-0', 'rows': '3'}}) }}
                    </div>

                    <div class="mb-4">
                        <label class="text-secondary-alpha small text-uppercase ls-1">Zone Logistique (Frais de port)</label>
                        {{ form_widget(form.city, {'attr': {'class': 'form-select bg-transparent border-alpha text-white rounded-0'}}) }}
                        <div class="form-text text-secondary-alpha italic small">Laissez vide pour un retrait au quartier général (Gratuit).</div>
                    </div>

                    <button type="submit" class="btn btn-alpha-action w-100 py-3 fw-black text-uppercase transform-hover">
                        Confirmer les coordonnées
                    </button>
                {{ form_end(form) }}
            </div>
        </div>

        {# Colonne de droite : Récapitulatif Panier #}
        <div class="col-lg-4">
            <div class="card bg-dark-alpha border-alpha rounded-0 p-4 shadow-lg">
                <h4 class="text-white fw-black text-uppercase ls-1 mb-4">
                    <i class="bi bi-cart-check text-primary-alpha me-2"></i>Récapitulatif
                </h4>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary-alpha">Articles :</span>
                    <span class="text-white fw-bold">{{ totalQuantite }}</span>
                </div>

                <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-3">
                    <span class="text-secondary-alpha">Frais de livraison :</span>
                    <span id="shipping-cost" class="text-primary-alpha italic">Sélectionnez une ville</span> {#! voir si frais en temps réel possible #}
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-white fw-black text-uppercase">Total estimé</span>
                    <span class="fs-4 fw-black text-primary-alpha">
                        {# Calcul temporaire du total (avec de port) #}
                        {{ total_items|number_format(2, ',', ' ') }} €
                    </span>
                </div>
            </div>

            {# Rappel de sécurité style Alpha #}
            <div class="mt-4 p-3 border border-alpha bg-black bg-opacity-25 shadow-sm">
                <small class="text-secondary-alpha italic d-block">
                    <i class="bi bi-shield-lock me-2"></i>Transaction sécurisée par le protocole Alpha Commando.
                </small>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a href="{{ path('app_cart') }}" class="text-secondary-alpha text-decoration-none hover-gold small">
            <i class="bi bi-arrow-left me-1"></i> MODIFIER LE PANIER
        </a>
    </div>
</div>

{#! ----------------- JavaScript -------------------- #}
<script src="https://code.jquery.com/jquery-4.0.0.min.js" integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao=" crossorigin="anonymous"></script>
<script>
$(document).ready(function() {
    const citySelector = $('#order_city');
    const cityValue = citySelector.val();

    const url = `/order/get-shipping-cost/${cityValue}`;

    //requete ajax
    $.ajax({
        url: url,
        type: 'GET',
        success: function(response) {
        const newResponse = JSON.parse(response)
        if (parseInt(newResponse.status) === 200) {
            console.log(newResponse.status)
            $("#shipping-cost").text(newResponse.content)
        }
        },
        error: function(xhr, status, error) {

        }
    })
    citySelector.on('change', function() {
        alert('hello world')
    })
})
</script>

{% endblock %}