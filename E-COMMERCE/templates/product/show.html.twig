{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
<div class="container">
    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Description du produit</th>
                <td>{{ product.productDescription }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ product.stock }}</td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex flex-column align-items-start gap-3">

        <a class="btn btn-warning" href="{{ path('app_product_edit', {'id': product.id}) }}">Modifier</a>

        <a class="btn btn-info" href="{{ path('app_product_stock_add', {'id': product.id}) }}">Ajouter du stock</a>

        <a class="btn btn-dark" href="{{ path('app_product_stock_add_history', {'id': product.id}) }}">Voir l'historique des stocks</a>

        {{ include('product/_delete_form.html.twig') }}

        <a class="btn btn-light" href="{{ path('app_product_index') }}">Retour aux listes</a>
    </div>
</div>
{% endblock %}
